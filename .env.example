# Copy this file to .env for local testing, or set these as Environment
# Variables in Render's dashboard for production. NEVER commit a real .env
# file or paste real secret keys into a chat, code review, or public repo.

# From your Flutterwave dashboard: Settings -> API Keys
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Any long random string, used to sign access tokens (cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Fee in whole Naira (Flutterwave, unlike Paystack, does NOT use kobo).
FEE_NGN=500

# Admin login for /admin — choose your own username and a strong password.
# Anyone with these credentials can view, upload, and delete assignment
# images for every department, so keep them private.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-strong-password

# From your Brevo dashboard (app.brevo.com): Settings -> SMTP & API -> API Keys.
# BREVO_FROM must be a sender you've verified in Brevo (Settings ->
# Senders, Domains & Dedicated IPs -> Senders) — usually your own email
# address works, no need to own a custom domain.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM=youremail@example.com
BREVO_FROM_NAME=Departmental Assignment Register

# CRITICAL: your MongoDB Atlas connection string (free M0 tier works
# fine). From your Atlas dashboard: Database -> Connect -> Drivers ->
# copy the connection string, then replace <password> with your actual
# database user's password. Payment records and recovery codes are
# stored here — without this, those features will fail with a clear
# error rather than silently losing data.
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=school_departments

# CRITICAL: your Cloudinary credentials (free tier works fine). From
# your Cloudinary dashboard homepage: Cloud Name, API Key, and API
# Secret are shown right at the top. Assignment images are stored here
# instead of local disk, since Render's disk doesn't survive redeploys
# on the free tier.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Port Render will inject automatically; safe to leave as-is
PORT=3000
